# DepositGuard Backend Environment Variables

# Application Settings
APP_NAME=DepositGuard
ENVIRONMENT=development
DEBUG=True

# Supabase Auth, Postgres & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min32bytes

# Database connection URL (defaults to local sqlite for zero-dependency development/testing)
DATABASE_URL=sqlite:///./depositguard.db

# CORS Allowed Origins (comma-separated: frontend local Vite dev + production deployment)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Groq Tier 1 Primary AI Provider (Optional, defaults to openai/gpt-oss-20b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Reserved for Run 2 (Do not alter or substitute model IDs):
GEMINI_API_KEY=
GEMINI_MODEL_REASONING=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
